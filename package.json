{
  "name": "matchmaking-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Next-generation Discord matchmaking platform (bot + API + dashboard)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:bot": "npm run dev -w @matchmaking/bot",
    "db:generate": "npm run generate -w @matchmaking/db",
    "db:migrate": "npm run migrate -w @matchmaking/db",
    "db:studio": "npm run studio -w @matchmaking/db",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "@types/node": "^22.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
