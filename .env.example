# ---- Discord ----
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
# Public invite URL is built from CLIENT_ID after the bot is added.

# ---- Core / storage backend ----
# Storage backend: "memory" (dev/demo, no deps) or "postgres" (production)
STORAGE_BACKEND=memory
DATABASE_URL=postgresql://match:match@localhost:5432/matchmaking?schema=public

# Queue/pubsub backend: "memory" or "redis" (production, distributed)
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379

# ---- API / Dashboard (later phases) ----
API_PORT=4000
DASHBOARD_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-too

# ---- Bot behavior ----
# Max concurrent matches per user (safety)
MAX_MATCHES_PER_USER=1
# Default conversation cap in seconds (0 = unlimited). Admin configurable later.
MAX_CONVERSATION_SECONDS=0
# Max matches per hour per user (anti-abuse). 0 = unlimited.
MAX_MATCHES_PER_HOUR=0
# Environment
NODE_ENV=development
LOG_LEVEL=info
